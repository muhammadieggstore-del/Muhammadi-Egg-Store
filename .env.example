# Gemini API key, if your app uses Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public app URL, if required by your hosting platform.
APP_URL="https://example.com"

# Admin credentials. Set these only on the backend host; never commit real values.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"

# If frontend and backend are hosted separately, set this to the backend URL.
# Example: https://api.example.com
VITE_API_BASE_URL=""

# Exact frontend origin for CORS when using a separate frontend.
# Example: https://username.github.io
FRONTEND_ORIGIN="*"
